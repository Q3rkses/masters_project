# Build directories
build/
Build/
build-*/

# Generated simulation/filter/smoother output
output/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
data/
.cache/
.venv/
figures/

# finished experiments are curated and tracked; only the top-level scratch dirs stay ignored
!results/*/data/
!results/*/figures/
!results/*/*/*/data/
!results/*/*/*/figures/
!results/*/*/*/*/figures/

# the 3d csv files are large (hundreds of MB), generate them with the executable
results/INS3D/*/*/data/

# 1D Monte Carlo: the runs themselves are temporary, the reduced data, stats and figures are kept
!results/1D/monte_carlo/data/
!results/1D/monte_carlo/figures/
!results/1D/mistuned/*/monte_carlo/data/

# python bytecode
__pycache__/

# 2D INS Monte Carlo: keep stats and figures, the summaries are rebuilt by the script
!results/INS2D*/*/*/monte_carlo/*/figures/
!results/INS2D*/*/*/monte_carlo/*/data/
results/INS2D*/*/*/monte_carlo/*/summary.npy
